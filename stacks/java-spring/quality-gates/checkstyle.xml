<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Mechanical naming and structure gate. Structural layering lives in ArchUnit; judgment
  about whether a name is *good* stays with the reviewer and core/review-checklist.md.

  Design note 1 — identifier length is deliberately NOT constrained. A length floor
  cannot tell `usrSvc` from `id`, so it rejects `main`, `id` and loop counters while
  letting every real abbreviation through.

  Design note 2 — the banned forms are matched only where they END a camelCase segment,
  via the trailing (?![a-z]) guard. That is what separates `getUsrSvc` (banned) from
  `generateReport`, `repositories`, `attract` and `calculus` (all fine): in those the
  segment continues past the trigram. `s?` catches plurals like `getAttrs`.
  The list was validated against every word in the en_US dictionary woven into ten
  camelCase shapes — 758k identifiers, zero false positives. Add to it only after
  re-running installer/src/tests/checkstyle.test.ts.

  The lookahead is repeated per identifier kind because Checkstyle cannot share a format
  across name modules. Keep the copies in sync.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Optional so a project without a suppression file still initializes. The
         quality-gates directory ships a starter checkstyle-suppressions.xml. -->
    <module name="SuppressionFilter">
        <property name="file" value="checkstyle-suppressions.xml"/>
        <property name="optional" value="true"/>
    </module>
    <!-- Escape hatch: @SuppressWarnings("checkstyle:MethodLength") on the rare justified case. -->
    <module name="SuppressWarningsFilter"/>

    <module name="LineLength">
        <property name="max" value="140"/>
        <property name="ignorePattern" value="^\s*(package|import)\s|^\s*\*\s*https?://"/>
    </module>
    <module name="FileTabCharacter"/>

    <module name="TreeWalker">
        <module name="SuppressWarningsHolder"/>

        <!-- Rejects runs of capitals: dtoDTO, parseHTTPUrl, XMLParser. -->
        <module name="AbbreviationAsWordInName">
            <property name="allowedAbbreviationLength" value="1"/>
            <property name="ignoreOverriddenMethods" value="true"/>
            <property name="ignoreStaticFinal" value="true"/>
        </module>

        <module name="TypeName">
            <property name="format"
                      value="^(?!.*(?i:usr|svc|mgr|cfg|tmp|idx|qty|amt|pwd|btn|msg|calc|attr|repo|addr|resp|desc|ctx|cnt|obj|prop|tot|req)s?(?![a-z]))[A-Z][a-zA-Z0-9]*$"/>
        </module>
        <!-- The trailing _scenario groups allow the shouldDoX_whenY test naming from testing.md. -->
        <module name="MethodName">
            <property name="format"
                      value="^(?!.*(?i:usr|svc|mgr|cfg|tmp|idx|qty|amt|pwd|btn|msg|calc|attr|repo|addr|resp|desc|ctx|cnt|obj|prop|tot|req)s?(?![a-z]))[a-z][a-zA-Z0-9]*(_[a-zA-Z0-9]+)*$"/>
        </module>
        <module name="MemberName">
            <property name="format"
                      value="^(?!.*(?i:usr|svc|mgr|cfg|tmp|idx|qty|amt|pwd|btn|msg|calc|attr|repo|addr|resp|desc|ctx|cnt|obj|prop|tot|req)s?(?![a-z]))[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="ParameterName">
            <property name="format"
                      value="^(?!.*(?i:usr|svc|mgr|cfg|tmp|idx|qty|amt|pwd|btn|msg|calc|attr|repo|addr|resp|desc|ctx|cnt|obj|prop|tot|req)s?(?![a-z]))[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="LocalVariableName">
            <property name="format"
                      value="^(?!.*(?i:usr|svc|mgr|cfg|tmp|idx|qty|amt|pwd|btn|msg|calc|attr|repo|addr|resp|desc|ctx|cnt|obj|prop|tot|req)s?(?![a-z]))[a-z][a-zA-Z0-9]*$"/>
        </module>
        <!--
          ConstantName covers every `static final` field, which in practice includes
          holders that are not constants: a Lombok-free `Logger log` and `serialVersionUID`.
          Those are allowed by name rather than by weakening SCREAMING_CASE for real
          constants. ArchUnit's `static final ArchRule` fields are camelCase by its own
          idiom and cannot be renamed — they are excluded per-file in
          checkstyle-suppressions.xml, which matters because includeTestSourceDirectory
          is on.
        -->
        <module name="ConstantName">
            <property name="format" value="^(log|logger|serialVersionUID|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
        </module>

        <!-- Readability floors that mirror the clean-code structure rules. -->
        <module name="MethodLength">
            <property name="max" value="40"/>
            <property name="countEmpty" value="false"/>
        </module>
        <module name="NestedIfDepth">
            <property name="max" value="2"/>
        </module>
        <module name="LeftCurly"/>
        <module name="NeedBraces"/>
        <module name="UnusedImports"/>
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored"/>
        </module>
        <!-- Test code is exempted in checkstyle-suppressions.xml: assertion literals are
             not magic numbers, and suppressing them one by one is worse than the disease. -->
        <module name="MagicNumber">
            <property name="ignoreAnnotation" value="true"/>
            <property name="ignoreFieldDeclaration" value="true"/>
            <property name="ignoreHashCodeMethod" value="true"/>
        </module>
    </module>
</module>
