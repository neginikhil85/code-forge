<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Enforces naming discipline and comment hygiene; structural rules live in ArchUnit. -->
<module name="Checker">
    <property name="severity" value="error"/>

    <module name="TreeWalker">
        <!-- No abbreviations: identifiers must not be single letters or compressed forms.
             Test methods additionally allow the methodName_scenario form.
             Full naming judgment stays with the reviewer; this catches mechanical offenders. -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]{4,}(_[a-zA-Z0-9]+)?$"/>
        </module>
        <module name="ClassName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]{4,}$"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]{3,}$"/>
        </module>
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]{2,}$"/>
        </module>
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]{2,}$"/>
        </module>

        <!-- Comment hygiene: Javadoc is optional; narration comments are the reviewer's job, not the code's. -->
        <module name="JavadocType">
            <property name="allowMissingPropertyJavadoc" value="true"/>
        </module>

        <!-- Readability floors that match clean-code structure rules. -->
        <module name="MethodLength">
            <property name="max" value="40"/>
        </module>
        <module name="LineLength">
            <property name="max" value="140"/>
        </module>
        <module name="LeftCurly"/>
        <module name="NeedBraces"/>
    </module>
</module>
